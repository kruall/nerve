# Nerve — Environment Variables
# Copy to .env and fill in your values.
# Loaded from the resolved config directory; also used by Docker setup.

# Authentication (at least one required)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_CODE_OAUTH_TOKEN=                # OAuth token (Pro/Max subscription — from `claude setup-token` or host extraction)

# Optional
OPENAI_API_KEY=
GH_TOKEN=                              # GitHub token (from `gh auth token` or host extraction)
NERVE_MODE=personal
NERVE_TIMEZONE=America/New_York

# Langfuse (optional). Credentials alone enable the Python/Claude exporter.
# Codex transcript export additionally requires this explicit privacy opt-in
# and uses Nerve's reviewed, pinned plugin revision by default.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
TRACE_TO_LANGFUSE=false
